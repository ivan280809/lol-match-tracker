[Unit]
Description=Back up and restore-verify LoL Tracker database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/lol-tracker/ops/minipc
ExecStart=/usr/bin/python3 /opt/lol-tracker/ops/minipc/manager.py backup
TimeoutStartSec=1200
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lol-tracker
