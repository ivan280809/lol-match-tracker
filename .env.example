APP_IMAGE=ghcr.io/ivan280809/lol-match-tracker:latest

DB_NAME=micros
DB_USER=postgres
DB_PASSWORD=change-me

RIOT_API_KEY=replace-with-riot-api-key
RIOT_API_REGION=EUROPE

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

APP_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
APP_POLL_FIXED_DELAY=PT5M
APP_POLL_INITIAL_DELAY=PT30S
APP_POLL_SCHEDULER_TICK=PT30S
APP_POLL_ENABLED=true
APP_POLL_MANUAL_ONLY=false
APP_POLL_MATCH_WINDOW_SIZE=10
APP_POLL_PAGINATION_LIMIT=3
APP_HTTP_TIMEOUT=PT10S
APP_HTTP_CONNECT_TIMEOUT=PT10S
APP_HTTP_RETRY_MAX_ATTEMPTS=3
APP_HTTP_RETRY_BACKOFF=PT1S
APP_TIME_ZONE=Europe/Madrid
APP_DASHBOARD_GUARD_ENABLED=false
APP_DASHBOARD_GUARD_USERNAME=admin
APP_DASHBOARD_GUARD_PASSWORD=
